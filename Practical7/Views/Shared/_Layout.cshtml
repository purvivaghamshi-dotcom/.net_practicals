<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Feedback Management</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f4f4;
            color: #111;
        }

        /* HEADER */

        .header {
            width: 100%;
            background: #000;
            color: #fff;
            padding: 20px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .header h2 {
                margin: 0;
            }

            .header a {
                color: #fff;
                text-decoration: none;
                margin-left: 25px;
                padding: 8px 12px;
            }

                .header a:hover {
                    background: #fff;
                    color: #000;
                }

        /* MAIN */

        .container {
            width: 100%;
            min-height: 600px;
            padding: 50px 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        /* BOX */

        .box {
            width: 100%;
            max-width: 520px;
            background: #fff;
            padding: 40px;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

            .box h1,
            .box h2 {
                text-align: center;
                margin-top: 0;
                margin-bottom: 30px;
            }

        /* FORM */

        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
            }

        .form-control {
            width: 100%;
            height: 44px;
            padding: 10px 13px;
            border: 1px solid #aaa;
            border-radius: 5px;
        }

        /* BUTTON */

        .btn {
            display: inline-block;
            padding: 12px 25px;
            background: #000;
            color: #fff;
            border: 2px solid #000;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
        }

            .btn:hover {
                background: #fff;
                color: #000;
            }

        /* ERROR */

        .error {
            display: block;
            color: red;
            font-size: 13px;
            margin-top: 5px;
        }

        /* SUCCESS */

        .success {
            background: #000;
            color: #fff;
            padding: 12px;
            text-align: center;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        /* DETAILS */

        .details {
            margin-bottom: 30px;
            padding: 20px;
            background: #fafafa;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

            .details h3 {
                text-align: center;
                margin-top: 0;
            }

        .detail-row {
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
        }

        .detail-label {
            display: inline-block;
            width: 120px;
            font-weight: bold;
        }

        /* FOOTER */

        .footer {
            width: 100%;
            background: #000;
            color: #fff;
            text-align: center;
            padding: 18px;
        }

            .footer p {
                margin: 0;
            }
    </style>
</head>

<body>

    @Html.Partial("_Header")

    <div class="container">

        @RenderBody()

    </div>

    @Html.Partial("_Footer")

</body>
</html>